<Window x:Class="Pdofile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="using:Pdofile.View">
  <!-- Dark theme modelled on Acrobat: near-black title bar, dark chrome rails, mid-grey document area. -->
  <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
        RequestedTheme="Dark" Background="#1B1B1B">
    <Grid.Resources>
      <SolidColorBrush x:Key="ChromeDarkBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="ChromeBrush" Color="#252525" />
      <SolidColorBrush x:Key="ChromeLineBrush" Color="#383838" />
      <SolidColorBrush x:Key="TabBrush" Color="#333333" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />

      <!-- Lightweight styling: flat buttons, blue-tinted selected tool. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3A3A3A" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#444444" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#3A3A3A" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#444444" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2C4A6E" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#355A85" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#264060" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#8CC0FF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#A8D0FF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#8CC0FF" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />

      <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
      </Style>
      <Style x:Key="RailToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
      </Style>
      <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
      </Style>
      <Style x:Key="ShapeToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
      </Style>
      <Style x:Key="Sep" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,8" />
        <Setter Property="Background" Value="{StaticResource ChromeLineBrush}" />
      </Style>
      <Style x:Key="RailSep" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource ChromeLineBrush}" />
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Title bar: menu, app name, document tab, drag area (caption buttons drawn by Windows) ===== -->
    <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource ChromeDarkBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="CaptionColumn" Width="140" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource BarButton}" Margin="6,0,0,0" ToolTipService.ToolTip="Menu">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE700;" FontSize="14" />
          <TextBlock Text="Menu" FontSize="13" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Text="Open…" Click="Open_Click">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
              <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" IsEnabled="False" /></MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Save" Click="Save_Click">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
              <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" IsEnabled="False" /></MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Save as…" Click="SaveAs_Click">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Export flattened copy (for students)…" Click="Export_Click">
              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <TextBlock Grid.Column="1" Text="pdofile" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="10,0,14,0" />
      <Border x:Name="DocTab" Grid.Column="2" Background="{StaticResource TabBrush}" CornerRadius="8,8,0,0"
              Margin="0,6,0,0" Padding="14,0,14,0" VerticalAlignment="Stretch" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <FontIcon Glyph="&#xEA90;" FontSize="13" Foreground="#E5534B" />
          <TextBlock x:Name="TabTitle" FontSize="13" MaxWidth="320" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Grid x:Name="TitleDrag" Grid.Column="3" Background="Transparent" />
    </Grid>

    <!-- ===== Top bar: file actions, tool options (colours, size, eraser mode), settings ===== -->
    <Border Grid.Row="1" Background="{StaticResource TabBrush}" BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="0,0,0,1">
      <Grid Height="46" Padding="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Style="{StaticResource BarButton}" Click="Open_Click" ToolTipService.ToolTip="Open (Ctrl+O)">
            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
          </Button>
          <Button Style="{StaticResource BarButton}" Click="Save_Click" ToolTipService.ToolTip="Save (Ctrl+S)">
            <FontIcon Glyph="&#xE74E;" FontSize="16" />
          </Button>
          <Border Style="{StaticResource Sep}" />
          <Button Style="{StaticResource BarButton}" Click="Undo_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)">
            <FontIcon Glyph="&#xE7A7;" FontSize="16" />
          </Button>
          <Button Style="{StaticResource BarButton}" Click="Redo_Click" ToolTipService.ToolTip="Redo (Ctrl+Y)">
            <FontIcon Glyph="&#xE7A6;" FontSize="16" />
          </Button>
        </StackPanel>

        <ScrollViewer Grid.Column="1" HorizontalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
          <Border x:Name="ToolOptions" Background="{StaticResource ChromeBrush}" CornerRadius="8" Padding="10,0" Height="36"
                  BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="ToolLabel" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" MinWidth="70" />
              <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
              <Border Style="{StaticResource Sep}" />
              <Button Style="{StaticResource BarButton}" Padding="8,4" ToolTipService.ToolTip="Size  ( [ and ] keys )">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xEDA8;" FontSize="14" />
                  <TextBlock x:Name="SizeLabel" FontSize="12" Text="1.6 pt" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Width="240" Spacing="4">
                      <TextBlock x:Name="SizeHeader" Text="Pen width" />
                      <Slider x:Name="SizeSlider" ValueChanged="Size_Changed" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <ToggleButton x:Name="WholeBtn" Style="{StaticResource ShapeToggle}" Height="30" MinWidth="0" Padding="10,0" FontSize="12"
                            Click="Whole_Click" Content="Whole strokes" Visibility="Collapsed"
                            ToolTipService.ToolTip="Eraser removes whole strokes instead of only what it touches (Shift+E)" />
            </StackPanel>
          </Border>
        </ScrollViewer>

        <Button Grid.Column="2" Style="{StaticResource BarButton}" VerticalAlignment="Center" ToolTipService.ToolTip="Settings">
          <FontIcon Glyph="&#xE713;" FontSize="16" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="10" Width="260">
                <ComboBox x:Name="SmoothBox" Header="Ink smoothing" HorizontalAlignment="Stretch" SelectionChanged="Settings_Changed">
                  <x:String>Off</x:String>
                  <x:String>Light</x:String>
                  <x:String>Medium</x:String>
                  <x:String>Strong</x:String>
                </ComboBox>
                <ToggleSwitch x:Name="PressureSwitch" Header="Pen pressure" Toggled="Settings_Changed" />
                <ToggleSwitch x:Name="HoldSwitch" Header="Hold pen still to straighten shapes" Toggled="Settings_Changed" />
                <NumberBox x:Name="AxesUnitsBox" Header="Axes: ticks per side" Minimum="1" Maximum="40" SpinButtonPlacementMode="Inline" ValueChanged="AxesUnits_Changed" />
                <ToggleSwitch x:Name="AxesGridSwitch" Header="Axes: draw grid" Toggled="Settings_Changed" />
                <ToggleSwitch x:Name="AxesQuadSwitch" Header="Axes: first quadrant only" Toggled="Settings_Changed" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- ===== Main area: left tool rail | document | right navigation rail ===== -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="4" Padding="0,10,0,0">
          <ToggleButton x:Name="LassoBtn" Tag="Lasso" Style="{StaticResource RailToggle}" Click="Tool_Click" ToolTipService.ToolTip="Select (L): lasso ink to move, resize, rotate or recolour" ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xEF20;" FontSize="18" />
          </ToggleButton>
          <ToggleButton x:Name="HandBtn" Tag="Hand" Style="{StaticResource RailToggle}" Click="Tool_Click" ToolTipService.ToolTip="Pan (V, or hold Space)" ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xE759;" FontSize="18" />
          </ToggleButton>
          <Border Style="{StaticResource RailSep}" />
          <ToggleButton x:Name="PenBtn" Tag="Pen" Style="{StaticResource RailToggle}" Click="Tool_Click" ToolTipService.ToolTip="Pen (P). Hold Shift for a straight line." ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xEE56;" FontSize="18" />
          </ToggleButton>
          <ToggleButton x:Name="HlBtn" Tag="Highlighter" Style="{StaticResource RailToggle}" Click="Tool_Click" ToolTipService.ToolTip="Highlighter (H)" ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xE7E6;" FontSize="18" />
          </ToggleButton>
          <ToggleButton x:Name="EraserBtn" Tag="Eraser" Style="{StaticResource RailToggle}" Click="Tool_Click" ToolTipService.ToolTip="Eraser (E). The pen's eraser end, side button or right mouse button also erase." ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xE75C;" FontSize="18" />
          </ToggleButton>
          <ToggleButton x:Name="ShapesBtn" Style="{StaticResource RailToggle}" Click="Shapes_Click" ToolTipService.ToolTip="Shapes (S): line, arrow, rectangle, ellipse, axes" ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xE739;" FontSize="18" />
            <FlyoutBase.AttachedFlyout>
              <Flyout x:Name="ShapesFlyout" Placement="RightEdgeAlignedTop">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ToggleButton x:Name="LineBtn" Tag="Line" Style="{StaticResource ShapeToggle}" Click="Tool_Click" Content="╱" ToolTipService.ToolTip="Line (Shift snaps angles)" />
                  <ToggleButton x:Name="ArrowBtn" Tag="Arrow" Style="{StaticResource ShapeToggle}" Click="Tool_Click" Content="→" ToolTipService.ToolTip="Arrow" />
                  <ToggleButton x:Name="RectBtn" Tag="Rect" Style="{StaticResource ShapeToggle}" Click="Tool_Click" ToolTipService.ToolTip="Rectangle (Shift = square)">
                    <FontIcon Glyph="&#xE739;" FontSize="16" />
                  </ToggleButton>
                  <ToggleButton x:Name="EllipseBtn" Tag="Ellipse" Style="{StaticResource ShapeToggle}" Click="Tool_Click" ToolTipService.ToolTip="Ellipse (Shift = circle)">
                    <FontIcon Glyph="&#xEA3A;" FontSize="16" />
                  </ToggleButton>
                  <ToggleButton x:Name="AxesBtn" Tag="Axes" Style="{StaticResource ShapeToggle}" Click="Tool_Click" Content="Axes" FontSize="13" ToolTipService.ToolTip="Coordinate axes (options in Settings)" />
                </StackPanel>
              </Flyout>
            </FlyoutBase.AttachedFlyout>
          </ToggleButton>
          <ToggleButton x:Name="RulerBtn" Style="{StaticResource RailToggle}" Click="Ruler_Click" ToolTipService.ToolTip="Ruler (R). Drag to move, drag ⟳ or scroll over it to rotate; draw along its edge for straight lines." ToolTipService.Placement="Right">
            <FontIcon Glyph="&#xED5E;" FontSize="18" />
          </ToggleButton>
        </StackPanel>
      </Border>

      <view:DocumentView x:Name="DocView" Grid.Column="1" />

      <StackPanel x:Name="EmptyHint" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <FontIcon Glyph="&#xEA90;" FontSize="56" Foreground="#E5534B" HorizontalAlignment="Center" />
        <TextBlock Text="Open a PDF to start writing" FontSize="22" HorizontalAlignment="Center" />
        <Button Content="Open PDF…  (Ctrl+O)" Click="Open_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Padding="18,8" />
        <TextBlock Text="or drop a PDF file anywhere in this window" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
      </StackPanel>

      <Border x:Name="NavRail" Grid.Column="2" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeLineBrush}" BorderThickness="1,0,0,0">
        <StackPanel x:Name="NavPanel" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed">
          <Button Style="{StaticResource RailButton}" Click="PrevPage_Click" ToolTipService.ToolTip="Previous page (Page Up)" ToolTipService.Placement="Left">
            <FontIcon Glyph="&#xE70E;" FontSize="14" />
          </Button>
          <TextBox x:Name="PageBox" Width="44" MinWidth="0" Padding="2,5" TextAlignment="Center" HorizontalAlignment="Center"
                   KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus" ToolTipService.ToolTip="Type a page number and press Enter" />
          <TextBlock x:Name="PageLabel" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,2" />
          <Button Style="{StaticResource RailButton}" Click="NextPage_Click" ToolTipService.ToolTip="Next page (Page Down)" ToolTipService.Placement="Left">
            <FontIcon Glyph="&#xE70D;" FontSize="14" />
          </Button>
          <Border Style="{StaticResource RailSep}" Margin="10,10" />
          <Button Style="{StaticResource RailButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in (Ctrl++)" ToolTipService.Placement="Left">
            <FontIcon Glyph="&#xE8A3;" FontSize="16" />
          </Button>
          <TextBlock x:Name="ZoomLabel" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />
          <Button Style="{StaticResource RailButton}" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out (Ctrl+-)" ToolTipService.Placement="Left">
            <FontIcon Glyph="&#xE71F;" FontSize="16" />
          </Button>
          <Button Style="{StaticResource RailButton}" Click="Fit_Click" ToolTipService.ToolTip="Fit width (Ctrl+0)" ToolTipService.Placement="Left">
            <FontIcon Glyph="&#xE9A6;" FontSize="16" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
